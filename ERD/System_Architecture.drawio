        <mxCell id="step4Detail" value="Named Entity Recognition + POS tagging for technical terms (e.g., &#39;GraphQL API&#39;, &#39;Microservices&#39;)&#xa;Model: en_core_web_sm (spaCy 3.x)&#xa;Confidence: 0.6-0.9 | Speed: Medium 🔄" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="230" y="620" width="750" height="50" as="geometry" />
        </mxCell>
        <mxCell id="arrow2_4" value="" style="endArrow=classic;html=1;strokeWidth=3;strokeColor=#FF6B35;" parent="1" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="585" y="690" as="sourcePoint" />
            <mxPoint x="585" y="730" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step5Box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FF6B35;strokeWidth=3;align=left;" parent="1" vertex="1">
          <mxGeometry x="140" y="740" width="890" height="100" as="geometry" />
        </mxCell>
        <mxCell id="step5Number" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FF6B35;strokeColor=#FF6B35;fontColor=#FFFFFF;fontSize=18;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="160" y="765" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="step5Title" value="NLP Processing - Layer 3: Context Validation" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;fontColor=#333333;" parent="1" vertex="1">
          <mxGeometry x="230" y="750" width="400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="step5Detail" value="Check surrounding words, filter false positives (e.g., &#39;Java coffee&#39; → ❌, &#39;Java Developer&#39; → ✅)&#xa;Method: Window-based context analysis (±5 words)&#xa;Confidence: Adjusted -0.3 if suspicious | Speed: Slower 🐌" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="230" y="780" width="750" height="50" as="geometry" />
        </mxCell>
        <mxCell id="arrow2_5" value="" style="endArrow=classic;html=1;strokeWidth=3;strokeColor=#00AA88;" parent="1" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="585" y="850" as="sourcePoint" />
            <mxPoint x="585" y="890" as="targetPoint" />
