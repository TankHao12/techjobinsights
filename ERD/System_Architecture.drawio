            <mxPoint x="585" y="1070" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step7Box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#00AA88;strokeWidth=3;align=left;" parent="1" vertex="1">
          <mxGeometry x="140" y="1080" width="890" height="100" as="geometry" />
