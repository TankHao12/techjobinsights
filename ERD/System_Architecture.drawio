          <mxGeometry x="160" y="1265" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="step8Title" value="API Layer (FastAPI)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;fontColor=#333333;" parent="1" vertex="1">
          <mxGeometry x="230" y="1250" width="400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="step8Detail" value="FastAPI serves JSON → REST endpoints with pagination, filtering, sorting&#xa;Features: OpenAPI docs, async handlers, Pydantic validation&#xa;Endpoints: /jobs, /analytics/skills, /analytics/trends, /companies, /categories" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#666666;" parent="1" vertex="1">
