        </mxCell>
        <mxCell id="step6Box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#00AA88;strokeWidth=3;align=left;" parent="1" vertex="1">
          <mxGeometry x="140" y="900" width="890" height="120" as="geometry" />
        </mxCell>
        <mxCell id="step6Number" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#00AA88;strokeColor=#00AA88;fontColor=#FFFFFF;fontSize=18;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="160" y="925" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="step6Title" value="Skill Storage (JSONB)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;fontColor=#333333;" parent="1" vertex="1">
          <mxGeometry x="230" y="910" width="400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="step6Detail" value="Store extracted skills in JSONB → Array of {skill, confidence, extraction_method}&#xa;Table: jobs.extracted_skills (JSONB column)&#xa;Example: {&quot;languages&quot;: [&quot;Python&quot;, &quot;JavaScript&quot;], &quot;frameworks&quot;: [&quot;React&quot;, &quot;Django&quot;], &quot;cloud&quot;: [&quot;AWS&quot;]}&#xa;Index: GIN index on extracted_skills for fast queries" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="230" y="940" width="750" height="70" as="geometry" />
        </mxCell>
        <mxCell id="arrow2_6" value="" style="endArrow=classic;html=1;strokeWidth=3;strokeColor=#00AA88;" parent="1" edge="1">
